; Asset project for the Trump character mod.
; Paths inside mirror the game's res:// layout so the packed files land exactly where the game looks.
; This project is only used to import textures and pack trump_character.pck (see scripts/build.ps1).

config_version=5

[application]

config/name="trump_character_assets"
config/features=PackedStringArray("4.5", "C#")

[dotnet]

project/assembly_name="trump_character"
